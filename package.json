{
  "name": "hls-streamer",
  "version": "3.1.0",
  "description": "Lightweight HLS streaming from audio files (MP3, AAC, M4A, OGG, FLAC, WAV) on demand, without temporary files or ffmpeg dependency",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist/ && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --module CommonJS --outDir dist/cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm test",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LordVersA/hls-streamer.git"
  },
  "keywords": [
    "hls",
    "streaming",
    "mp3",
    "aac",
    "m4a",
    "ogg",
    "flac",
    "wav",
    "audio",
    "http-live-streaming",
    "media",
    "ffmpeg-free",
    "on-demand",
    "typescript",
    "nodejs",
    "vorbis",
    "audio-streaming"
  ],
  "author": {
    "name": "LordVersA",
    "url": "https://github.com/LordVersA"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LordVersA/hls-streamer/issues"
  },
  "homepage": "https://github.com/LordVersA/hls-streamer#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.8.3",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {}
}
